// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  friendlyId String   @unique
  name      String
  salt     String
  decks    Deck[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DeckStatus {
  VALID
  INCOMPLETE
  ILLEGAL
  DEFAULT
}

model Deck {
  id        String   @id @default(uuid())
  name      String
  tag       String
  userId    String
  status    DeckStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deckListRecords DeckListRecord[]

  user User @relation(fields: [userId], references: [id])
}

model Card {
  id        String   @id @default(uuid())
  name      String
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cardSets CardSet[]
}

model CardSet {
  id        String   @id @default(uuid())
  card    Card     @relation(fields: [cardId], references: [id])
  cardId  String
  amount Int
  deckListRecords DeckListRecord[]
  archetypeConditions ArchetypeCondition[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum GameStatus {
  PENDING
  REJECTED
  COMPLETED
  DELETED
}

model Game {
  id        String   @id @default(uuid())
  deck1Id  String
  deck2Id  String
  player1Result Int
  player2Result Int
  status    GameStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Archetype {
  id        String   @id @default(uuid())
  name      String @unique
  conditions ArchetypeCondition[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DeckListRecord {
  id       String   @id @default(uuid())
  deck    Deck    @relation(fields: [deckId], references: [id])
  deckId  String
  set     CardSet @relation(fields: [setId], references: [id])
  setId   String
}

model ArchetypeCondition {
  id        String   @id @default(uuid())
  archetype Archetype @relation(fields: [archetypeId], references: [id])
  archetypeId String
  set     CardSet @relation(fields: [setId], references: [id])
  setId   String
}






